{
  "name": "bridge-to-fig",
  "version": "1.3.0",
  "private": true,
  "description": "Real-time bridge between AI agents and Figma. Workspace root.",
  "scripts": {
    "check": "bash scripts/check-prereqs.sh",
    "predev": "bash scripts/check-prereqs.sh && pnpm --filter @bridge-to-fig/shared build",
    "dev": "pnpm --filter @bridge-to-fig/server dev",
    "build": "bash scripts/check-prereqs.sh && pnpm -r build",
    "build:plugin": "pnpm --filter @bridge-to-fig/shared build && pnpm --filter @bridge-to-fig/plugin build"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.33.2"
}
